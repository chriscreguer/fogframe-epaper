// Copy this file to secrets.h (same folder) and fill in real values.
// secrets.h is gitignored — the real credentials never get committed.
#pragma once
static const char* WIFI_SSID = "your-network-name";  // 2.4GHz only (ESP32-S3 can't see 5GHz)
static const char* WIFI_PASS = "your-password";

// Where the panel fetches the packed frame. For a public repo this is the raw
// URL of device/frame.bin on your default branch. For a PRIVATE repo (which is
// what the README recommends, since the frame maps where you have been) you
// need an authenticated URL — see "Keeping your data private" in the README.
static const char* IMG_URL =
    "https://raw.githubusercontent.com/YOURNAME/YOURREPO/main/device/frame.bin";
